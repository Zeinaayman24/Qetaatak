{
  "expo": {
    "name": "ضغطة",
    "slug": "qetaatak",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.qetaatak.app"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#041D3F",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.qetaatak.app"
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "output": "single",
      "name": "ضغطة",
      "lang": "ar"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "ضغطة بتستخدم مكانك عشان تحدّد مكان محلك على الخريطة."
        }
      ]
    ],
    "scheme": "qetaatak",
    "experiments": {
      "typedRoutes": false,
      "baseUrl": "/daghta"
    },
    "extra": {
      "supportsRTL": true,
      "forcesRTL": true
    }
  }
}